{
  "name": "ansec-evaluacion-desempeno",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace api run dev",
    "build": "npm --workspace web run build && npm --workspace api run build",
    "typecheck": "npm --workspace web run typecheck && npm --workspace api run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@apollo/protobufjs@1.2.8": true
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
